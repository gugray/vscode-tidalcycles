{
  "name": "anode-vscode-relay",
  "displayName": "Anode JS relay for VSCode",
  "description": "Relays JS file changes for live coding",
  "version": "2.0.0",
  "publisher": "gugray",
  "icon": "images/icon128.png",
  "repository": "https://github.com/gugray/vscode-tidalcycles",
  "license": "GPL-3.0",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:javascript"
  ],
  "main": "./out/src/main",
  "contributes": {
    "commands": [
      {
        "command": "anode.eval",
        "title": "Anode Eval"
      },
      {
        "command": "anode.evalMulti",
        "title": "Anode Eval Multiline"
      }
    ],
    "keybindings": [
      {
        "command": "anode.eval",
        "key": "Shift+Enter",
        "when": "resourceExtname == '.js'"
      },
      {
        "command": "anode.evalMulti",
        "key": "Ctrl+Enter",
        "mac": "Cmd+Enter",
        "when": "resourceExtname == '.js'"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Anode Configuration",
      "properties": {
        "anode.relayUrl": {
          "type": "string",
          "default": "",
          "description": "URL where evaluated commands are relayed to."
        },
        "anode.feedbackColor": {
          "type": "string",
          "default": "rgba(100,250,100,0.3)",
          "description": "The highlight color to use when evaluating code."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "anode",
          "title": "Anode",
          "icon": "images/tidal.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "mocha --require ts-node/register test/*.test.ts",
    "test:coverage": "nyc npm run test",
    "test:integration": "vscode-test",
    "prepare": "husky",
    "pretty-quick-staged": "pretty-quick --staged",
    "lint": "eslint --ext .ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@types/chai": "^4.3.4",
    "@types/glob": "^8.1.0",
    "@types/js-yaml": "^4.0.5",
    "@types/mocha": "^10.0.1",
    "@types/mock-require": "^3.0.0",
    "@types/node": "22.13.14",
    "@types/sinon": "^17.0.4",
    "@types/split2": "^4.2.0",
    "@types/vscode": "1.99.0",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "chai": "^4.3.7",
    "eslint": "^9.23.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "mocha": "^10.2.0",
    "mock-require": "^3.0.3",
    "nyc": "^17.1.0",
    "prettier": "^3.5.3",
    "pretty-quick": "^4.1.1",
    "semantic-release": "^24.2.3",
    "semantic-release-stop-before-publish": "^1.0.0",
    "semantic-release-vsce": "^6.0.7",
    "sinon": "^20.0.0",
    "ts-node": "^10.9.2",
    "typemoq": "^2.1.0",
    "typescript": "5.8.2",
    "typescript-eslint": "^8.29.0"
  },
  "dependencies": {
    "command-exists-promise": "^2.0.2",
    "js-yaml": "^4.1.0",
    "node-wav-player": "^0.2.0",
    "split2": "^4.2.0"
  },
  "vsce": {
    "dependencies": true,
    "yarn": false
  }
}
